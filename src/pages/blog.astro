---
import "../styles/index.css";

import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import WorkList from "../components/WorkList.astro";
import { openGraph } from "spectre:globals";

const posts = await getCollection("posts", (post) => post.data.draft !== true);
const tags = [...new Set(posts.flatMap((post) => post.data.tags.map((tag) => tag.id)))].sort();
const PROPOSE = "https://github.com/hacklab-esgi/hacklab-web/issues/new?template=article.yaml";
const items = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  author: post.data.author,
  date: post.data.createdAt,
  href: `/blog/${post.id}/`,
  tags: post.data.tags.map((tag) => tag.id),
}));
---

<Layout
  ogImage="/og/pages/articles.png"
  title={openGraph.blog.title || "Articles"}
  description={openGraph.blog.description}
>
  <PageIntro
    slot="left"
    title="Articles"
    lead="Écrits par les membres du HackLab : recherches, outils et retours d’expérience."
  >
    <nav class="tags" aria-label="Filtrer par tag">
      {tags.map((tag) => <a class="tag" href="/blog/" data-tag={tag}>{tag}</a>)}
    </nav>
    <a class="button" href={PROPOSE} target="_blank" rel="noopener">Proposer un article</a>
    <a href="/api/articles-rss.xml">Flux RSS des articles</a>
  </PageIntro>

  <div class="layout-grid-right" slot="right">
    <WorkList items={items} />
    <p class="no-match" hidden>Aucun article ne porte tous ces tags. <a href="/blog/">Afficher tous les articles</a></p>
  </div>
</Layout>

<script>
  // Filtre par tags via l'URL (/blog?tags=a,b) : un article doit porter tous les tags choisis
  const current = new URL(window.location.href).searchParams.get("tags")?.split(",").filter(Boolean) ?? [];

  document.querySelectorAll<HTMLAnchorElement>(".tag").forEach((tag) => {
    const name = tag.dataset.tag!;
    const active = current.includes(name);
    const next = active ? current.filter((t) => t !== name) : [...current, name];
    tag.classList.toggle("active", active);
    tag.setAttribute("aria-pressed", String(active));
    tag.href = next.length ? `/blog/?tags=${next.join(",")}` : "/blog/";
  });

  const rows = document.querySelectorAll<HTMLElement>(".work-list li[data-tags]");
  let shown = 0;
  rows.forEach((row) => {
    const match = current.every((t) => row.dataset.tags!.split(",").includes(t));
    row.hidden = !match;
    if (match) shown++;
  });
  document.querySelector<HTMLElement>(".no-match")!.hidden = shown > 0;
</script>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    color: #e0e0e0;
    font-size: 0.9375rem;
    text-decoration: none;
    border: 1px solid #333;
    border-radius: 999px;
  }

  @media (hover: hover) and (pointer: fine) {
    .tag:hover {
      color: #fff;
      text-decoration: none;
      border-color: #555;
    }
  }

  .tag.active {
    color: #fff;
    background: var(--accent-fill);
    border-color: var(--accent-fill);
  }

  .tag:focus-visible {
    outline: 2px solid #e0e0e0;
    outline-offset: 2px;
  }

  .no-match {
    color: #c7c7c7;
  }
</style>

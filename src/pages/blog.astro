---
import "../styles/index.css";

import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import WorkList from "../components/WorkList.astro";
import { CATEGORIES } from "../lib/articles";
import { openGraph } from "spectre:globals";

const posts = await getCollection("posts", (post) => post.data.draft !== true);
const PROPOSE = "https://github.com/hacklab-esgi/hacklab-web/issues/new?template=article.yaml";
const items = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  author: post.data.author,
  date: post.data.createdAt,
  href: `/blog/${post.id}/`,
  category: post.data.category,
  tags: post.data.tags,
}));
const count = (id: string) => posts.filter((post) => post.data.category === id).length;
---

<Layout
  ogImage="/og/pages/articles.png"
  title={openGraph.blog.title || "Articles"}
  description={openGraph.blog.description}
>
  <PageIntro
    slot="left"
    title="Articles"
    lead="Écrits par les membres du HackLab : recherches, outils et retours d’expérience."
  >
    <nav class="filters" aria-label="Filtrer par catégorie">
      <a class="pill" href="/blog/" data-cat="">Tous <span class="count">{posts.length}</span></a>
      {
        Object.entries(CATEGORIES).map(([id, label]) => (
          <a class="pill" href={`/blog/?cat=${id}`} data-cat={id}>{label} <span class="count">{count(id)}</span></a>
        ))
      }
    </nav>
    <!-- Tags choisis en cliquant sur un tag d'article : remplis par le script, un clic retire le filtre -->
    <p class="filters chosen-tags" hidden><span>Tag :</span></p>
    <a class="button" href={PROPOSE} target="_blank" rel="noopener">Proposer un article</a>
    <a href="/api/articles-rss.xml">Flux RSS des articles</a>
  </PageIntro>

  <div class="layout-grid-right" slot="right">
    <WorkList items={items} />
    <p class="no-match" hidden>Aucun article ne correspond à ce filtre. <a href="/blog/">Afficher tous les articles</a></p>
  </div>
</Layout>

<script>
  // Filtres par l'URL : /blog/?cat=defensif&tags=soc,kql (une catégorie, et tous les tags demandés)
  const params = new URL(window.location.href).searchParams;
  const cat = params.get("cat") ?? "";
  const tags = params.get("tags")?.split(",").filter(Boolean) ?? [];
  const url = (c: string, t: string[]) => {
    const query = [c && `cat=${encodeURIComponent(c)}`, t.length && `tags=${t.map(encodeURIComponent).join(",")}`].filter(Boolean).join("&");
    return query ? `/blog/?${query}` : "/blog/";
  };

  // Catégories : celle en cours est marquée, et changer de catégorie garde le tag choisi
  document.querySelectorAll<HTMLAnchorElement>(".filters [data-cat]").forEach((link) => {
    const active = link.dataset.cat === cat;
    link.classList.toggle("active", active);
    if (active) link.setAttribute("aria-current", "true");
    link.href = url(link.dataset.cat!, tags);
  });

  // Tags choisis : une pastille par tag. Le nom vient de l'URL : il est posé en texte, jamais en HTML.
  const chosen = document.querySelector<HTMLElement>(".chosen-tags")!;
  for (const tag of tags) {
    const link = document.createElement("a");
    link.className = "pill active";
    link.href = url(cat, tags.filter((t) => t !== tag));
    link.textContent = `${tag} ✕`;
    link.setAttribute("aria-label", `Retirer le filtre ${tag}`);
    chosen.append(link);
  }
  chosen.hidden = tags.length === 0;

  let shown = 0;
  document.querySelectorAll<HTMLElement>(".work-list li").forEach((row) => {
    const rowTags = row.dataset.tags?.split(",") ?? [];
    const match = (!cat || row.dataset.cat === cat) && tags.every((t) => rowTags.includes(t));
    row.hidden = !match;
    if (match) shown++;
  });
  document.querySelector<HTMLElement>(".no-match")!.hidden = shown > 0;
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--muted);
  }

  /* « hidden » doit l'emporter sur display: flex */
  .filters[hidden] {
    display: none;
  }

  /* :global : les pastilles des tags choisis sont créées par le script */
  .filters :global(.pill) {
    padding: 0.25rem 0.75rem;
    font-size: 0.9375rem;
  }

  .count {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .pill.active .count {
    color: #fff;
  }

  .no-match {
    color: #c7c7c7;
  }
</style>

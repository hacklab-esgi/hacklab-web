---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title={"Page introuvable | HackLab ESGI"}
  description={"Cette page n'existe pas ou a été déplacée."}
>
  <section class="notfound" slot="404" aria-labelledby="notfound-title">
    <p class="notfound-code text-glow" aria-hidden="true">404</p>
    <h1 id="notfound-title">Cette page n’existe pas</h1>
    <p class="notfound-text">Elle a peut-être été déplacée, ou l’adresse contient une faute de frappe.</p>
    <div class="notfound-actions">
      <a class="button button-primary" href="/">Retour à l’accueil</a>
      <a class="button" href="/blog">Voir les articles</a>
      <a class="button" href="/agenda">Voir l’agenda</a>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: 2rem 1rem;
    text-align: center;
  }

  .notfound-code {
    margin: 0;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: var(--fw-bold);
    line-height: 1;
  }

  h1 {
    margin: 1rem 0 0.5rem;
    font-size: 1.75rem;
  }

  .notfound-text {
    max-width: 44ch;
    margin: 0 0 2rem;
    color: #c7c7c7;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>

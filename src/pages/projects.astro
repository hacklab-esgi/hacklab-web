---
import "../styles/index.css";

import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import WorkList from "../components/WorkList.astro";
import { openGraph } from "spectre:globals";

const projects = await getCollection("projects", (project) => !project.data.draft);
const items = projects.map((project) => ({
  title: project.data.title,
  description: project.data.description,
  author: project.data.author,
  date: project.data.date,
  href: `/projects/${project.id}`,
}));
const PROPOSE = "https://github.com/hacklab-esgi/hacklab-web/issues/new?template=project.yaml";
---

<Layout
  ogImage="/og/pages/projets.png"
  title={openGraph.projects.title || "Projets"}
  description={openGraph.projects.description}
>
  <PageIntro
    slot="left"
    title="Projets"
    lead="Les outils, scripts et recherches développés par les membres du HackLab."
  >
    {
      items.length > 0 && (
        <>
          <a class="button" href={PROPOSE} target="_blank" rel="noopener">Proposer un projet</a>
          <a href="/api/projects-rss.xml">Flux RSS des projets</a>
        </>
      )
    }
  </PageIntro>

  <div class="layout-grid-right" slot="right">
    {
      items.length > 0 ? (
        <WorkList items={items} />
      ) : (
        <div class="empty">
          <h2>Aucun projet publié pour l’instant</h2>
          <p>
            Un outil, un script, une recherche en cours ? Proposez-le avec une issue GitHub : il sera relu par
            l’équipe puis publié ici.
          </p>
          <a class="button button-primary" href={PROPOSE} target="_blank" rel="noopener">Proposer un projet</a>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .empty {
    padding: 2rem 0;
    border-block: 1px solid #262626;
  }

  .empty h2 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
  }

  .empty p {
    max-width: 60ch;
    margin: 0 0 1.5rem;
    color: #c7c7c7;
  }
</style>

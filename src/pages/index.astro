---
import "../styles/index.css";

import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { name, openGraph } from "spectre:globals";
import NextSession from "../components/NextSession.astro";
import SessionLog from "../components/SessionLog.astro";
import Socials from "../components/Socials.astro";
import WorkList from "../components/WorkList.astro";

const [posts, projects] = await Promise.all([
  getCollection("posts", (post) => !post.data.draft),
  getCollection("projects", (project) => !project.data.draft),
]);
const work = [
  { title: "Articles des membres", all: "/blog/", allLabel: "Tous les articles", items: posts.map((p) => ({ ...p.data, date: p.data.createdAt, href: `/blog/${p.id}/`, tags: undefined })) },
  { title: "Projets des membres", all: "/projects/", allLabel: "Tous les projets", items: projects.map((p) => ({ ...p.data, href: `/projects/${p.id}/` })) },
].filter((section) => section.items.length > 0);

// Données structurées : l'association et ses comptes officiels (même liste que les liens de la colonne)
const socials = await getCollection("socials");
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name,
  url: Astro.site?.href,
  logo: new URL("/favicon.png", Astro.site).href,
  sameAs: socials.map((social) => social.data.link),
};
---

<Layout
  ogImage="/og/pages/accueil.png"
  title={openGraph.home.title || name}
  description={openGraph.home.description}
  jsonLd={organization}
>
  <aside class="layout-grid-left-sticky home-aside" slot="left">
    <img class="home-logo" width={96} height={101} src="/favicon.png" alt="" loading="eager" />
    <h1 class="home-name">{name}</h1>
    <p class="home-lead">
      Le laboratoire associatif de cybersécurité de l’<a href="https://www.esgi.fr/" target="_blank" rel="noopener">ESGI</a>.
      Étudiants et alumni y présentent leurs recherches, leurs outils et leurs retours d’expérience.
    </p>
    <Socials />
  </aside>

  <div class="layout-grid-right home-main" slot="right">
    <NextSession />
    <SessionLog />

    {
      work.map((section) => (
        <section class="work" aria-label={section.title}>
          <h2>{section.title}</h2>
          <WorkList items={section.items} limit={2} />
          <a class="work-all" href={section.all}>{section.allLabel}</a>
        </section>
      ))
    }
  </div>
</Layout>

<script>
  // Heures dans le fuseau du visiteur (heure de Paris précisée s'il est ailleurs)
  import { localizeTimes } from "../scripts/local-times";
  localizeTimes();
</script>

<style>
  .home-aside {
    gap: 1.25rem;
  }

  .home-logo {
    width: 96px;
    height: auto;
  }

  .home-name {
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.1;
  }

  .home-lead {
    margin: 0;
    color: #c7c7c7;
  }

  .home-main {
    gap: 3.5rem;
  }

  .work h2 {
    margin: 0 0 1rem;
    font-size: 1.5rem;
  }

  /* Lien seul sur sa ligne : zone tactile de 26 px au lieu de 18 */
  .work-all {
    display: inline-block;
    margin-top: 0.75rem;
    padding-block: 0.25rem;
  }

  /* Une colonne : la phrase de présentation en premier (le visiteur sait où il est), puis le travail ;
     le logo, le nom et les réseaux restent en bas. Les enfants de la colonne deviennent des cases de la grille. */
  @media screen and (max-width: 1380px) {
    .home-aside {
      display: contents;
    }

    .home-aside > :global(*) {
      order: 2;
    }

    .home-aside > .home-lead {
      order: 0;
    }

    .home-main {
      order: 1;
    }
  }
</style>

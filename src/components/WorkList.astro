---
// Liste d'articles ou de projets des membres (accueil, /blog, /projects)
export interface WorkItem {
  title: string;
  description: string;
  author?: string;
  date: Date;
  href: string;
  tags?: string[];
}

interface Props {
  items: WorkItem[];
  limit?: number;
}
const { items, limit } = Astro.props;

const day = (d: Date) => d.toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris', day: 'numeric', month: 'long', year: 'numeric' });
const sorted = [...items].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, limit);
---

<ul class="work-list">
  {
    sorted.map((item) => (
      <li data-tags={item.tags?.join(',')}>
        <a class="work-item" href={item.href}>
          <span class="work-title">{item.title}</span>
          {item.description !== item.title && <span class="work-description">{item.description}</span>}
          <span class="work-meta">
            {item.author && <span class="work-author">@{item.author.replace(/^@/, '')}</span>}
            <span>{day(item.date)}</span>
            {item.tags && item.tags.length > 0 && <span>{item.tags.join(', ')}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .work-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid #262626;
  }

  .work-list li {
    border-top: 1px solid #262626;
  }

  .work-item {
    display: grid;
    gap: 0.375rem;
    padding: 1rem 0.75rem;
    color: inherit;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-item:hover {
      color: inherit;
      text-decoration: none;
      background: var(--graphite);
    }
  }

  .work-item:focus-visible {
    outline: 2px solid #e0e0e0;
    outline-offset: 2px;
  }

  .work-title {
    color: #fff;
    font-size: 1.3125rem;
    font-weight: var(--fw-bold);
    line-height: 1.25;
  }

  .work-description {
    max-width: 70ch;
    color: #c7c7c7;
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .work-author {
    color: var(--accent);
    font-weight: var(--fw-bold);
  }
</style>

---
// Liste d'articles ou de projets des membres (accueil, /blog, /projects)
import { CATEGORIES, type Category } from '../lib/articles';

export interface WorkItem {
  title: string;
  description: string;
  author?: string;
  date: Date;
  href: string;
  category?: Category;
  tags?: string[];
}

interface Props {
  items: WorkItem[];
  limit?: number;
}
const { items, limit } = Astro.props;

const day = (d: Date) => d.toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris', day: 'numeric', month: 'long', year: 'numeric' });
const sorted = [...items].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, limit);
---

<ul class="work-list">
  {
    sorted.map((item) => (
      <li data-cat={item.category} data-tags={item.tags?.join(',')}>
        <div class="work-item">
          <a class="work-title" href={item.href}>{item.title}</a>
          {item.description !== item.title && <span class="work-description">{item.description}</span>}
          <span class="work-meta">
            {item.author && <span class="work-author">@{item.author.replace(/^@/, '')}</span>}
            <span>{day(item.date)}</span>
            {item.category && <span>{CATEGORIES[item.category]}</span>}
          </span>
          {item.tags && item.tags.length > 0 && (
            <span class="work-tags">
              {item.tags.map((tag) => <a class="pill" href={`/blog/?tags=${tag}`}>{tag}</a>)}
            </span>
          )}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .work-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid #262626;
  }

  .work-list li {
    border-top: 1px solid #262626;
  }

  .work-item {
    position: relative;
    display: grid;
    gap: 0.375rem;
    padding: 1rem 0.75rem;
    border-radius: 0.5rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-item:hover {
      background: var(--graphite);
    }
  }

  .work-title,
  .work-title:hover {
    color: #fff;
    font-size: 1.3125rem;
    font-weight: var(--fw-bold);
    line-height: 1.25;
    text-decoration: none;
  }

  /* Toute la ligne est cliquable : le lien du titre la recouvre, les tags restent cliquables par-dessus */
  .work-title::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
  }

  .work-title:focus-visible {
    outline: none;
  }

  .work-title:focus-visible::after {
    outline: 2px solid #e0e0e0;
    outline-offset: 2px;
  }

  .work-description {
    max-width: 70ch;
    color: #c7c7c7;
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .work-author {
    color: var(--accent);
    font-weight: var(--fw-bold);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .work-tags a {
    position: relative;
    z-index: 1;
  }
</style>

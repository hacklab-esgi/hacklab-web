---
// Une session du journal : tuile de date, titre, lieu et intervenant ; détails dépliables
import { type Session, formatHour } from '../lib/sessions';
import Icon from './Icon.astro';

interface Props {
  session: Session;
}
const { session: s } = Astro.props;
const upcoming = s.start.getTime() > Date.now();

const part = (opts: Intl.DateTimeFormatOptions) => s.start.toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris', ...opts });
const day = part({ day: 'numeric' });
const month = part({ month: 'short' });
const full = part({ weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<li class="entry">
  <details>
    <summary>
      <time class="entry-date" datetime={s.start.toISOString()} aria-label={full}>
        <span class="entry-day" data-dt={s.start.toISOString()} data-fmt="day">{day}</span>
        <span class="entry-month" data-dt={s.start.toISOString()} data-fmt="month">{month}</span>
      </time>
      <span class="entry-main">
        <span class="entry-title">{s.title}</span>
        <span class="entry-meta">
          <span class="entry-place">
            <Icon type="lucide" name="map-pin" width={14} height={14} aria-hidden="true" />
            <span class="sr-only">Lieu : </span>{s.place}
          </span>
          {s.speaker && (
            <span class:list={["entry-speaker", { upcoming }]}>
              <Icon type="lucide" name="mic" width={14} height={14} aria-hidden="true" />
              <span class="sr-only">Intervenant : </span>{s.speaker}
            </span>
          )}
        </span>
      </span>
      <svg class="entry-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" />
      </svg>
    </summary>
    <div class="entry-body">
      <p class="entry-when" data-dt={s.start.toISOString()} data-fmt="full-hour">{full.charAt(0).toUpperCase() + full.slice(1)} à {formatHour(s.start)}</p>
      {s.description && <p class="entry-description">{s.description}</p>}
      {s.url && <a href={s.url} target="_blank" rel="noopener">Page de l'événement</a>}
    </div>
  </details>
</li>

<style>
  .entry {
    border-top: 1px solid #262626;
  }

  summary {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: 0.875rem 0.75rem;
    cursor: pointer;
    list-style: none;
    border-radius: 0.5rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover {
      background: var(--graphite);
    }
  }

  summary:focus-visible {
    outline: 2px solid #e0e0e0;
    outline-offset: 2px;
  }

  .entry-date {
    display: grid;
    place-items: center;
    padding: 0.375rem 0;
    line-height: 1.1;
    border: 1px solid #2e2e2e;
    border-radius: 0.5rem;
  }

  .entry-day {
    color: #fff;
    font-size: 1.375rem;
    font-weight: var(--fw-bold);
  }

  .entry-month {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .entry-main {
    display: grid;
    gap: 0.25rem;
  }

  .entry-title {
    color: #fff;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .entry-place,
  .entry-speaker {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .entry-place :global(svg),
  .entry-speaker :global(svg) {
    flex-shrink: 0;
  }

  /* L'intervenant en violet, comme l'auteur d'un article : doux pour le passé, vif pour une session à venir */
  .entry-speaker {
    color: var(--accent-past);
  }

  .entry-speaker.upcoming {
    color: var(--accent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .entry-chevron {
    color: var(--muted);
    transition: transform 160ms var(--ease-out);
  }

  details[open] .entry-chevron {
    transform: rotate(180deg);
  }

  .entry-body {
    /* aligné sous le titre : tuile + gouttière + marge intérieure */
    margin: 0 0 1.25rem calc(3.5rem + 1.25rem + 0.75rem);
    max-width: 64ch;
  }

  .entry-when {
    margin: 0 0 0.5rem;
    color: var(--muted);
  }

  .entry-description {
    margin: 0 0 0.75rem;
    color: #c7c7c7;
    white-space: pre-line;
  }

  @media screen and (max-width: 640px) {
    summary {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      gap: 0.875rem;
      padding-inline: 0.25rem;
    }

    .entry-body {
      margin-left: calc(3rem + 0.875rem + 0.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-chevron {
      transition: none;
    }
  }
</style>

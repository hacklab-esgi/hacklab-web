---
import Icon from "./Icon.astro";
import { name } from "spectre:globals";

const path = Astro.url.pathname;
---

<nav>
  <div class="nav-container">
    <a class="site-title" href="/">{name}</a>
    <ul>
      <li>
        <a href="/about" class:list={{ active: path === "/about" }}
          >Le laboratoire</a
        >
      </li>
      <li class="nav-separator">/</li>
      <li>
        <a href="/join" class:list={{ active: path === "/join" }}
          >Nous rejoindre</a
        >
      </li>
      <li class="nav-separator">/</li>
      <li>
        <a href="/blog" class:list={{ active: path === "/blog" }}>Articles</a>
      </li>
      <li class="nav-separator">/</li>
      <li>
        <a href="/projects" class:list={{ active: path === "/projects" }}
          >Projets</a
        >
      </li>
    </ul>
    <button class="mobile-nav-toggle" aria-label="Menu" aria-expanded="false">
      <Icon
        type="lucide"
        name="menu"
        width={24}
        height={24}
        class="menu-closed"
      />
      <Icon type="lucide" name="x" width={24} height={24} class="menu-open" />
    </button>
  </div>
</nav>
<script is:inline>
  const navToggle = document.querySelector(".mobile-nav-toggle");

  navToggle?.addEventListener("click", () => {
    const open = document.querySelector("nav").classList.toggle("active");
    navToggle.classList.toggle("active", open);
    navToggle.setAttribute("aria-expanded", String(open));
  });
</script>
<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 999;
    background-color: #121212;
    border-bottom: 1px solid #353535;
    padding-top: 2rem;
    padding-bottom: 2rem;
    padding-inline: 1rem;
  }

  nav .nav-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-title {
    font-weight: var(--fw-bold);
    text-decoration: none;
    font-size: 1.25em;
    z-index: 2;
  }

  nav ul {
    display: flex;
    font-weight: var(--fw-normal);
    font-size: 1.05em;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style-type: none;
    align-items: center;
  }

  nav ul li {
    position: relative;
  }

  nav a {
    color: inherit;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.active {
    background-color: var(--primary);
    outline: none;
  }

  .mobile-nav-toggle {
    display: none;
    width: 40px;
    height: 40px;
    background-color: #121212;
    border: 1px solid #353535;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
  }

  .menu-open {
    display: none;
  }

  .mobile-nav-toggle.active .menu-open {
    display: flex;
  }

  .mobile-nav-toggle.active .menu-closed {
    display: none;
  }

  @media screen and (max-width: 840px) {
    nav {
      padding: 2rem 1rem;
      padding-top: 2rem;
      transition: background-color 200ms ease;
    }

    .mobile-nav-toggle {
      display: flex;
    }

    .nav-separator {
      display: none;
    }

    nav ul {
      flex-direction: column;
      gap: 0;
      position: absolute;
      width: 100%;
      top: calc(1rem + 40px);
      right: 0;
      padding: 1rem;
      z-index: 1;
      opacity: 0;
      pointer-events: none;
      transition: opacity 150ms var(--ease-out); /* fermeture : plus rapide que l'ouverture */
      user-select: none;
      height: calc(100dvh - 1rem - 40px);
      align-items: start;
    }

    nav.active {
      background-color: #181818;
    }

    nav.active ul {
      opacity: 1;
      pointer-events: all;
      background-color: #181818;
    }

    nav ul li {
      position: relative;
      transition: transform 150ms var(--ease-out);
      transform: translateY(-8px);
      border-bottom: 1px solid #353535;
      width: 100%;
      max-width: none;
      padding: 0;
      font-size: 1.125em;
    }

    nav ul li a {
      display: block;
      padding: 0.75rem 0;
      width: 100%;
      padding-left: 1rem;
    }

    nav ul li:first-child {
      border-top: 1px solid #353535;
    }

    nav.active ul,
    nav.active ul li {
      transition-duration: 200ms;
    }

    nav.active ul li {
      transform: none;
    }

    /* Décalage à l'ouverture uniquement (les séparateurs cachés occupent les rangs pairs) */
    nav.active ul li:nth-child(3) { transition-delay: 30ms; }
    nav.active ul li:nth-child(5) { transition-delay: 60ms; }
    nav.active ul li:nth-child(7) { transition-delay: 90ms; }

    @media (prefers-reduced-motion: reduce) {
      nav ul li {
        transform: none;
      }
    }
  }
</style>

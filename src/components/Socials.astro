---
// Liens vers les réseaux du HackLab (colonne de présentation de l'accueil)
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const socials = await getCollection('socials');
---

<nav aria-label="Réseaux sociaux">
  <ul class="overview-list-media">
    {
      socials.map((item) => (
        <li>
          <a href={item.data.link} class="socials-link" target="_blank" rel="noopener">
            <Icon
              type={item.data.icon.type}
              name={item.data.icon.name as any}
              width={24}
              height={24}
              class="glow-icon"
            />
            <span>{item.data.text}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

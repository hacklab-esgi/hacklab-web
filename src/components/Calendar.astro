---
import { trainings } from '../lib/sessions';
---

<div id="calendar-wrapper">
  {
    // Légende affichée seulement s'il existe des entraînements CTF à distinguer des sessions
    trainings.length > 0 && (
      <fieldset class="cal-legend">
        <legend class="sr-only">Afficher dans le calendrier</legend>
        <label><input type="checkbox" data-type="session" checked /><span class="swatch swatch-session" aria-hidden="true"></span>Sessions</label>
        <label><input type="checkbox" data-type="training" checked /><span class="swatch swatch-training" aria-hidden="true"></span>Entraînements CTF</label>
      </fieldset>
    )
  }
  <p class="cal-tz" hidden>
    Heures affichées dans votre fuseau horaire (<span class="cal-tz-name"></span>). Les sessions ont lieu à l'heure de Paris.
  </p>
  <div id="calendar"></div>
</div>

<script>
  import { differsFromParis } from '../scripts/local-times';
  import { formatPlace, toText } from '../lib/places';
  import type { EventApi } from '@fullcalendar/core';

  // Infobulle au style du journal des sessions : mêmes icônes (Lucide), lieu, intervenant en violet doux
  const svg = (body: string) => `<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">${body}</svg>`;
  const ICON = {
    clock: svg('<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></g>'),
    pin: svg('<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></g>'),
    mic: svg('<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 19v3m7-12v2a7 7 0 0 1-14 0v-2"/><rect width="6" height="13" x="9" y="2" rx="3"/></g>'),
  };
  const HOUR: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit' };

  // events.json est rempli depuis Discord : rien n'entre dans la page sans être échappé ou filtré
  const esc = (s = '') => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const httpUrl = (u?: string) => (u && /^https?:\/\//i.test(u.trim()) ? u.trim() : undefined);
  // Description : seuls les retours à la ligne et les liens http(s) sont gardés, tout le reste devient du texte.
  // DOMParser crée un document inerte (aucun script ni gestionnaire d'événement n'y est exécuté).
  const safeHtml = (html = '') => {
    const out = document.createElement('div');
    const copy = (from: Node, to: Node) =>
      from.childNodes.forEach((node) => {
        if (node.nodeType === Node.TEXT_NODE) return void to.appendChild(document.createTextNode(node.textContent ?? ''));
        if (!(node instanceof Element)) return;
        if (node.tagName === 'BR') return void to.appendChild(document.createElement('br'));
        const href = node.tagName === 'A' ? httpUrl(node.getAttribute('href') ?? '') : undefined;
        if (!href) return copy(node, to);
        const a = Object.assign(document.createElement('a'), { href, target: '_blank', rel: 'noopener' });
        copy(node, a);
        to.appendChild(a);
      });
    copy(new DOMParser().parseFromString(html.replace(/<#\d+>/g, ''), 'text/html').body, out);
    return out.innerHTML;
  };

  const tooltipHtml = (event: EventApi) => {
    const { location, description, speaker } = event.extendedProps;
    const start = event.start!;
    const end = event.end ?? start;
    const day = start.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const range = (tz?: string) => `${start.toLocaleTimeString('fr-FR', { ...HOUR, timeZone: tz })} – ${end.toLocaleTimeString('fr-FR', { ...HOUR, timeZone: tz })}`;
    const hours = differsFromParis(start) ? `${range()} (${range('Europe/Paris')} à Paris)` : range();
    const place = formatPlace(location);
    const who = toText(speaker);
    const desc = safeHtml(description).trim();
    return `
      <p class="tt-title">${esc(event.title)}</p>
      <p class="tt-row">${ICON.clock}<span>${day.charAt(0).toUpperCase() + day.slice(1)}<br>${hours}</span></p>
      ${place ? `<p class="tt-row">${ICON.pin}<span>${esc(place)}</span></p>` : ''}
      ${who ? `<p class="tt-row tt-speaker">${ICON.mic}<span>${esc(who)}</span></p>` : ''}
      ${desc ? `<p class="tt-desc">${desc}</p>` : ''}
    `;
  };

  // Visiteur hors du fuseau de Paris : FullCalendar affiche ses heures locales, on le signale
  const tzNote = document.querySelector<HTMLElement>('.cal-tz');
  if (tzNote && differsFromParis(new Date())) {
    tzNote.querySelector('.cal-tz-name')!.textContent = Intl.DateTimeFormat().resolvedOptions().timeZone;
    tzNote.hidden = false;
  }
  const el = document.getElementById('calendar');

  // Une seule infobulle partagée (avant : une nouvelle div par rendu d'événement, jamais supprimée)
  const tooltip = document.createElement('div');
  tooltip.className = 'fc-event-tooltip';
  tooltip.hidden = true;
  document.body.appendChild(tooltip);

  // Positionne l'infobulle en la gardant dans l'écran (sinon elle déborde à droite sur mobile)
  const placeTooltip = (x: number, y: number) => {
    const maxLeft = window.scrollX + document.documentElement.clientWidth - tooltip.offsetWidth - 8;
    tooltip.style.left = Math.max(window.scrollX + 8, Math.min(x + 10, maxLeft)) + 'px';
    tooltip.style.top = y + 10 + 'px';
  };
  const hideTooltip = () => {
    tooltip.hidden = true;
    tooltip.classList.remove('is-touch');
  };

  // Souris : délai au premier survol (évite les clignotements en traversant la grille),
  // puis ouverture immédiate tant qu'on passe d'un événement à l'autre
  const HOVER_DELAY = 300;
  let warm = false;
  let showTimer: ReturnType<typeof setTimeout> | undefined;
  let coolTimer: ReturnType<typeof setTimeout> | undefined;
  let pointerX = 0;
  let pointerY = 0;

  // Au tactile, pas de survol : un tap ouvre les détails, un tap ailleurs les ferme
  document.addEventListener('click', (e) => {
    if (!tooltip.contains(e.target as Node)) hideTooltip();
  });

  // FullCalendar (~230 Ko) est chargé après la page, sans bloquer son affichage
  const init = async () => {
    const [{ Calendar }, { default: frLocale }, { default: dayGridPlugin }, { default: timeGridPlugin }, { default: listPlugin }, events] =
      await Promise.all([
        import('@fullcalendar/core'),
        import('@fullcalendar/core/locales/fr'),
        import('@fullcalendar/daygrid'),
        import('@fullcalendar/timegrid'),
        import('@fullcalendar/list'),
        fetch('/events/events.json').then((res) => res.json()),
      ]);

    const calendar = new Calendar(el, {
      plugins: [dayGridPlugin, timeGridPlugin, listPlugin],
      initialView: window.matchMedia('(max-width: 768px)').matches ? 'listYear' : 'dayGridMonth',
      locale: frLocale,
      hiddenDays: [0],
      headerToolbar: {
        left: 'prev,dynamicTitle,next',
        center: '',
        right: 'today timeGridWeek,dayGridMonth,listYear',
      },
      customButtons: {
        dynamicTitle: { text: '' },
      },
      views: {
        listYear: {
          type: 'list',
          duration: { years: 1 },
          buttonText: 'Année',
        },
      },
      events: events.map((ev: Record<string, any>) => ({
        title: ev.title,
        start: ev.start,
        end: new Date(new Date(ev.start).getTime() + (ev.duration ?? 1) * 3600e3),
        // Entraînements CTF (« type »: « training ») : contour au lieu d'aplat, masquables via la légende
        classNames: ev.type === 'training' ? ['is-training'] : [],
        extendedProps: {
          type: ev.type === 'training' ? 'training' : 'session',
          location: ev.location,
          description: ev.description,
          speaker: ev.speaker,
          url: httpUrl(ev.url),
        },
      })),
      // Vue liste : hauteur libre, toute la liste dans la page (sinon, sur mobile, elle défile dans une boîte de 200 px).
      // Grilles : proportions par défaut.
      viewDidMount({ view }) {
        calendar.setOption('height', view.type === 'listYear' ? 'auto' : undefined);
      },
      eventDidMount(info) {
        const { location, description, url, speaker } = info.event.extendedProps;
        // Heure du visiteur (FullCalendar travaille dans son fuseau) ; l'infobulle précise l'heure de Paris s'il est ailleurs
        const heure = info.event.start!.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

        info.el.querySelector('.fc-event-time')?.remove();
        info.el.querySelector('.fc-daygrid-event-dot')?.remove();

        const content = info.el.querySelector<HTMLElement>('.fc-event-title');
        if (content) {
          content.innerHTML = `<span aria-hidden="true">📌</span> ${heure}<br/>${esc(info.event.title)}`;
          content.style.whiteSpace = 'normal';
        }

        const details = tooltipHtml(info.event);
        info.el.style.cursor = 'pointer';

        let pointerType = 'mouse';
        info.el.addEventListener('pointerdown', (e) => { pointerType = e.pointerType; });

        info.el.addEventListener('click', (e) => {
          if (pointerType === 'mouse') {
            if (url) window.open(url, '_blank');
            return;
          }
          e.stopPropagation();
          tooltip.innerHTML = details + (url ? `<a href="${esc(url)}" target="_blank" rel="noopener">Plus d’infos →</a>` : '');
          tooltip.classList.add('is-touch');
          tooltip.hidden = false;
          const r = info.el.getBoundingClientRect();
          placeTooltip(r.left + window.scrollX, r.bottom + window.scrollY);
        });

        info.el.addEventListener('pointerenter', (e) => {
          if (e.pointerType !== 'mouse') return;
          pointerX = e.pageX;
          pointerY = e.pageY;
          clearTimeout(coolTimer);
          const show = () => {
            tooltip.innerHTML = details;
            tooltip.hidden = false;
            placeTooltip(pointerX, pointerY);
            warm = true;
          };
          if (warm) show();
          else showTimer = setTimeout(show, HOVER_DELAY);
        });
        info.el.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          pointerX = e.pageX;
          pointerY = e.pageY;
          if (!tooltip.hidden) placeTooltip(pointerX, pointerY);
        });
        info.el.addEventListener('pointerleave', (e) => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(showTimer);
          hideTooltip();
          coolTimer = setTimeout(() => { warm = false; }, HOVER_DELAY);
        });
      },
      datesSet() {
        const currentDate = calendar.getDate();
        const viewType = calendar.view.type;
        const year = currentDate.getFullYear();
        const month = currentDate.toLocaleString('fr-FR', { month: 'long' });

        let title = '';
        if (viewType === 'dayGridMonth') {
          title = `${month.charAt(0).toUpperCase() + month.slice(1)} ${year}`;
        } else if (viewType === 'timeGridWeek') {
          const tmp = new Date(Date.UTC(currentDate.getFullYear(), currentDate.getMonth(), currentDate.getDate()));
          const dayNum = tmp.getUTCDay() || 7;
          tmp.setUTCDate(tmp.getUTCDate() + 4 - dayNum);
          const yearStart = new Date(Date.UTC(tmp.getUTCFullYear(), 0, 1));
          const weekNumber = Math.ceil(((tmp.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
          title = `Semaine ${weekNumber} – ${year}`;
        } else if (viewType === 'listYear') {
          title = `${year}`;
        }

        const button = document.querySelector('.fc-dynamicTitle-button');
        if (button) button.textContent = title;
      },
    });

    calendar.render();

    // Légende : afficher ou masquer chaque type d'événement
    document.querySelectorAll<HTMLInputElement>('.cal-legend input').forEach((box) => {
      box.addEventListener('change', () => {
        calendar.getEvents()
          .filter((ev) => ev.extendedProps.type === box.dataset.type)
          .forEach((ev) => ev.setProp('display', box.checked ? 'auto' : 'none'));
      });
    });
  };

  if (el) init();
</script>

<style is:global>
  /* === CALENDAR WRAPPER === */
#calendar-wrapper {
  width: 100%;
  padding: 1rem;
  overflow: visible;
}

#calendar {
  width: 100%;
  background-color: #1a1a1a;
  border: 1px solid #353535;
  padding: 1rem;
  box-sizing: border-box;
  overflow: visible;
}

/* Responsive */
@media screen and (max-width: 640px) {
  /* Mobile : moins de marges autour de la liste, et les textes passent à la ligne au lieu de déborder */
  #calendar-wrapper {
    padding: 0;
  }
  #calendar {
    padding: 0.5rem;
  }
  .fc .fc-list-event-time {
    white-space: normal;
  }
  .fc .fc-list-event-title {
    overflow-wrap: anywhere;
  }
  .fc-toolbar-title {
    font-size: 1rem;
  }
  .fc-daygrid-day {
    height: 4rem;
  }
}

/* === LÉGENDE === */
.cal-tz {
  margin: 0 0 1rem;
  color: var(--muted);
  font-size: 0.875rem;
}

.cal-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  margin: 0 0 1rem;
  padding: 0;
  border: none;
}

.cal-legend label {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
}

.cal-legend input {
  accent-color: var(--fill);
}

.swatch {
  width: 1.75rem;
  height: 0.875rem;
  border-radius: 3px;
}

.swatch-session {
  background: var(--fill);
}

.swatch-training {
  border: 1.5px solid var(--fill);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* Entraînements CTF : contour au lieu d'aplat, pour les distinguer des sessions */
.fc .fc-event.is-training,
.fc .fc-daygrid-event.is-training,
.fc .fc-timegrid-event.is-training {
  color: #e0e0e0;
  background: #141414;
  border: 1.5px solid var(--fill);
}

.fc .fc-list-event.is-training .fc-list-event-dot {
  border-color: var(--fill);
  border-width: 2px;
  background: transparent;
  width: 10px;
  height: 10px;
}

/* === STRUCTURE GENERALE === */
.fc {
  /* Bordures et jour courant alignés sur la palette du site (au lieu du blanc et du jaune par défaut) */
  --fc-border-color: #2a2a2a;
  /* En-têtes de jour de la vue liste : sombres au lieu du blanc par défaut */
  --fc-neutral-bg-color: #1f1f1f;
  --fc-list-event-hover-bg-color: #222;
  /* Boutons neutres comme les boutons secondaires du site ; la vue active en bleu clair */
  --fc-button-text-color: #e0e0e0;
  --fc-button-bg-color: #1a1a1a;
  --fc-button-border-color: #333;
  --fc-button-hover-bg-color: #242424;
  --fc-button-hover-border-color: #555;
  --fc-button-active-bg-color: var(--fill);
  --fc-button-active-border-color: var(--fill);
  --fc-today-bg-color: rgba(255, 255, 255, 0.05);
  direction: ltr;
  text-align: left;
}

.fc-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.fc-toolbar-title,
.fc-col-header-cell-cushion,
.fc-list-day-side-text {
  text-transform: capitalize;
}

/* === TITRE ET BOUTONS === */
.fc-dynamicTitle-button {
  pointer-events: none;
  opacity: 1;
}

.fc-dynamicTitle-button:hover {
  background: var(--fc-button-bg-color);
  color: var(--fc-button-text-color);
}

.fc-button {
  border: 1px solid #333;
  padding: 0.25rem 0.5rem;
  cursor: pointer;
  border-radius: 4px;
}

.fc-button:focus,
.fc-button:active {
  outline: none !important;
  box-shadow: none !important;
}

/* Au clavier, le bouton qui a le focus reste repérable (même contour que le reste du site) */
.fc .fc-button:focus-visible {
  outline: 2px solid #e0e0e0 !important;
  outline-offset: 2px;
}

.fc-button-active {
  background-color: var(--fill) !important;
  color: var(--fill-ink) !important;
}

/* === GRID JOUR/MOIS === */
.fc-daygrid {
  border-collapse: collapse;
  width: 100%;
}

.fc-daygrid-day {
  border: 1px solid #353535;
  vertical-align: top;
  height: 6rem;
  padding: 0.25rem;
  font-size: 0.9rem;
}

.fc-daygrid-day-top {
  text-align: right;
  color: #999;
}

.fc-daygrid-event {
  background-color: var(--fill);
  color: var(--fill-ink);
  padding: 2px 4px;
  font-size: 0.8rem;
  border-radius: 3px;
  margin-top: 0.25rem;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fc-daygrid-event:hover,
.fc-daygrid-event:focus {
  background-color: var(--fill-hover);
  color: var(--fill-ink);
}

/* === TIMEGRID (VUE SEMAINE) === */
.fc-timegrid-event-harness {
  height: auto !important;
  min-height: 100% !important;
}

.fc-timegrid-event {
  background-color: var(--fill);
  color: var(--fill-ink);
  font-size: 0.75rem;
  padding: 2px 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  height: auto !important;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.fc-timegrid-event .fc-event-title {
  font-weight: var(--fw-bold);
  font-size: 0.75rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fc-timegrid-event .fc-event-icon {
  display: none;
}

/* === LIST (VUE ANNEE) === */
.fc-list-day-side-text {
  font-weight: var(--fw-bold);
}

.fc-list-event-time,
.fc-list-event-title {
  font-size: 0.85rem;
}

/* Supprimer les effets de hover list */
.fc .fc-list-event:hover,
.fc .fc-list-event:hover td,
.fc .fc-list-event:hover .fc-event-title,
.fc .fc-list-event:hover .fc-event-time {
  background-color: inherit !important;
  color: inherit !important;
}

/* === INFOS EVENTS === */
.fc-event-custom {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.fc-event-info {
  display: flex;
  flex-direction: column;
}

.fc-event-title {
  font-weight: var(--fw-bold);
  font-size: 0.85rem;
  white-space: normal !important;
  overflow: visible !important;
}

.fc-event-meta {
  font-size: 0.75rem;
  color: #ccc;
}

/* === TOOLTIP === */
.fc-event-tooltip {
  position: absolute;
  z-index: 9999;
  max-width: min(24rem, calc(100vw - 16px));
  padding: 0.875rem 1rem;
  color: #e0e0e0;
  font-size: 0.875rem;
  line-height: 1.45;
  background: #141414;
  border: 1px solid #2e2e2e;
  border-radius: 0.5rem;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  pointer-events: none;
}

.fc-event-tooltip p {
  margin: 0;
}

.tt-title {
  margin-bottom: 0.5rem !important;
  color: #fff;
  font-size: 0.9375rem;
  font-weight: var(--fw-bold);
}

.tt-row {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.25rem !important;
  color: var(--muted);
}

.tt-row svg {
  flex-shrink: 0;
  margin-top: 0.2em;
}

.tt-speaker {
  color: var(--accent-past);
}

.tt-desc {
  margin-top: 0.625rem !important;
  padding-top: 0.625rem;
  color: #c7c7c7;
  border-top: 1px solid #262626;
}

.fc-event-tooltip a {
  display: inline-block;
  margin-top: 0.625rem;
}

.fc-event-tooltip.is-touch {
  pointer-events: auto;
  transform-origin: top left; /* sort de l'événement touché, placé au-dessus à gauche */
  transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out);
}

@starting-style {
  .fc-event-tooltip.is-touch {
    opacity: 0;
    transform: scale(0.97);
  }
}

@media (prefers-reduced-motion: reduce) {
  @starting-style {
    .fc-event-tooltip.is-touch {
      transform: none; /* fondu seul, sans mouvement */
    }
  }
}

/* === DIVERS === */
.fc-col-header a,
.fc-scrollgrid a {
  color: white;
  text-decoration: none;
}

.fc-daygrid-day-number {
  color: #0ac9e0;
}

.fc-list-day-side-text,
.fc-list-day-text {
  text-decoration: none !important;
}

.fc-list-day-side-text:hover,
.fc-list-day-text:hover {
  color: var(--primary) !important;
  cursor: default;
}


/* ========== TOOLBAR FLEX FIX ========== */
@media screen and (max-width: 800px) {
  .fc-header-toolbar {
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .fc-toolbar-chunk {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .fc-button {
    flex: 0 1 auto;
    white-space: nowrap;
    text-align: center;
    margin-left: 0 !important;
  }

  .fc-button-group {
    margin-left: 0 !important;
  }
}



</style>

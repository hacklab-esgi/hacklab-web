<div id="calendar-wrapper">
  <div id="calendar"></div>
</div>

<script>
  import { Calendar } from '@fullcalendar/core';
  import frLocale from '@fullcalendar/core/locales/fr';
  import dayGridPlugin from '@fullcalendar/daygrid';
  import timeGridPlugin from '@fullcalendar/timegrid';
  import listPlugin from '@fullcalendar/list';

  const ICS_URL = 'webcal://hacklab.esgi.fr/calendar.ics';
  const el = document.getElementById('calendar');

  // Une seule infobulle partagée (avant : une nouvelle div par rendu d'événement, jamais supprimée)
  const tooltip = document.createElement('div');
  tooltip.className = 'fc-event-tooltip';
  tooltip.hidden = true;
  document.body.appendChild(tooltip);

  // Positionne l'infobulle en la gardant dans l'écran (sinon elle déborde à droite sur mobile)
  const placeTooltip = (x: number, y: number) => {
    const maxLeft = window.scrollX + document.documentElement.clientWidth - tooltip.offsetWidth - 8;
    tooltip.style.left = Math.max(window.scrollX + 8, Math.min(x + 10, maxLeft)) + 'px';
    tooltip.style.top = y + 10 + 'px';
  };
  const hideTooltip = () => {
    tooltip.hidden = true;
    tooltip.classList.remove('is-touch');
  };

  // Au tactile, pas de survol : un tap ouvre les détails, un tap ailleurs les ferme
  document.addEventListener('click', (e) => {
    if (!tooltip.contains(e.target as Node)) hideTooltip();
  });

  if (el) fetch('/events/events.json').then((res) => res.json()).then((events) => {
    const calendar = new Calendar(el, {
      plugins: [dayGridPlugin, timeGridPlugin, listPlugin],
      initialView: window.matchMedia('(max-width: 768px)').matches ? 'listYear' : 'dayGridMonth',
      locale: frLocale,
      hiddenDays: [0],
      headerToolbar: {
        left: 'prev,dynamicTitle,next',
        center: '',
        right: 'today timeGridWeek,dayGridMonth,listYear subscribeButton google',
      },
      customButtons: {
        dynamicTitle: { text: '' },
        // Icônes en CSS : elles s'affichent dès le premier rendu
        subscribeButton: {
          text: '\u00a0',
          hint: 'S’abonner au calendrier',
          click: () => { window.location.href = ICS_URL; },
        },
        google: {
          text: '\u00a0',
          hint: 'S’abonner au calendrier Google',
          click: () => {
            window.location.href = 'https://calendar.google.com/calendar/r?cid=' + encodeURIComponent(ICS_URL);
          },
        },
      },
      views: {
        listYear: {
          type: 'list',
          duration: { years: 1 },
          buttonText: 'Année',
        },
      },
      events: events.map((ev: Record<string, any>) => ({
        title: ev.title,
        start: ev.start,
        extendedProps: {
          location: ev.location,
          description: ev.description,
          speaker: ev.speaker,
          url: ev.url?.trim() || undefined,
        },
      })),
      eventDidMount(info) {
        const { location, description, url, speaker } = info.event.extendedProps;
        const heure = info.event.start!.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

        info.el.querySelector('.fc-event-time')?.remove();
        info.el.querySelector('.fc-daygrid-event-dot')?.remove();

        const content = info.el.querySelector<HTMLElement>('.fc-event-title');
        if (content) {
          content.innerHTML = `📌 ${heure}<br/>${info.event.title}`;
          content.style.whiteSpace = 'normal';
        }

        const details = `
          <strong>${info.event.title}</strong><br/>
          🕒 ${heure}<br/>
          📍 ${location}<br/>
          📝 ${description || 'Aucune description'}<br/>
          ${speaker?.trim() ? `👤 ${speaker}<br/>` : ''}
        `;
        info.el.style.cursor = 'pointer';

        let pointerType = 'mouse';
        info.el.addEventListener('pointerdown', (e) => { pointerType = e.pointerType; });

        info.el.addEventListener('click', (e) => {
          if (pointerType === 'mouse') {
            if (url) window.open(url, '_blank');
            return;
          }
          e.stopPropagation();
          tooltip.innerHTML = details + (url ? `<a href="${url}" target="_blank" rel="noopener">Plus d’infos →</a>` : '');
          tooltip.classList.add('is-touch');
          tooltip.hidden = false;
          const r = info.el.getBoundingClientRect();
          placeTooltip(r.left + window.scrollX, r.bottom + window.scrollY);
        });

        info.el.addEventListener('pointerenter', (e) => {
          if (e.pointerType !== 'mouse') return;
          tooltip.innerHTML = details;
          tooltip.hidden = false;
          placeTooltip(e.pageX, e.pageY);
        });
        info.el.addEventListener('pointermove', (e) => {
          if (e.pointerType === 'mouse') placeTooltip(e.pageX, e.pageY);
        });
        info.el.addEventListener('pointerleave', (e) => {
          if (e.pointerType === 'mouse') hideTooltip();
        });
      },
      datesSet() {
        const currentDate = calendar.getDate();
        const viewType = calendar.view.type;
        const year = currentDate.getFullYear();
        const month = currentDate.toLocaleString('fr-FR', { month: 'long' });

        let title = '';
        if (viewType === 'dayGridMonth') {
          title = `${month.charAt(0).toUpperCase() + month.slice(1)} ${year}`;
        } else if (viewType === 'timeGridWeek') {
          const tmp = new Date(Date.UTC(currentDate.getFullYear(), currentDate.getMonth(), currentDate.getDate()));
          const dayNum = tmp.getUTCDay() || 7;
          tmp.setUTCDate(tmp.getUTCDate() + 4 - dayNum);
          const yearStart = new Date(Date.UTC(tmp.getUTCFullYear(), 0, 1));
          const weekNumber = Math.ceil(((tmp.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
          title = `Semaine ${weekNumber} – ${year}`;
        } else if (viewType === 'listYear') {
          title = `${year}`;
        }

        const button = document.querySelector('.fc-dynamicTitle-button');
        if (button) button.textContent = title;
      },
    });

    calendar.render();
  });
</script>


---
// Cascadia Code (OFL), ramenée aux proportions de l'ancienne Consolas : 94 % de la taille
// (graisses réglées dans globals.css via --fw-normal / --fw-bold)
import cascadiaLatin from '@fontsource-variable/cascadia-code/files/cascadia-code-latin-wght-normal.woff2?url';
import cascadiaLatinExt from '@fontsource-variable/cascadia-code/files/cascadia-code-latin-ext-wght-normal.woff2?url';
import '../styles/globals.css';
import '../styles/footer.css';
import '../styles/reset.css';

import Background from '../components/Background.astro';
import Navbar from '../components/Navbar.astro';
import LayoutGrid from '../components/LayoutGrid.astro';
// import Announcement from '../components/Announcement.astro';
import { name, themeColor, twitterHandle } from 'spectre:globals';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	pagefindIgnore?: boolean;
	/** Image de partage générée (/og/…), prioritaire sur `image` */
	ogImage?: string;
	article?: {
		createdAt: Date;
		updatedAt?: Date;
	};
}

const { title, description, image, ogImage: generatedOgImage, pagefindIgnore, article } = Astro.props;
const fontFaces = [
	[cascadiaLatin, 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'],
	[cascadiaLatinExt, 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'],
]
	.map(([src, range]) => `@font-face { font-family: 'Cascadia HackLab'; font-style: normal; font-display: swap; font-weight: 200 700; size-adjust: 94%; src: url(${src}) format('woff2-variations'); unicode-range: ${range}; }`)
	.join('\n');
const canonical = new URL(Astro.url.pathname, Astro.site);
// L'image générée (/og/…) a priorité : même format de partage pour tous les articles
const ogImage = new URL(generatedOgImage || image?.src || '/img/hacklab.png', Astro.site);
---

<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preload" href={cascadiaLatin} as="font" type="font/woff2" crossorigin />
		<style is:inline set:html={fontFaces}></style>
		
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="theme-color" content={themeColor}>

		<link rel="canonical" href={canonical} />

		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonical} />
		{!article && <meta property="og:type" content="website" />}
		<meta property="og:locale" content="fr_FR" />

		{article && (
			<meta property="og:type" content="article" />
			<meta property="article:published_time" content={article.createdAt.toISOString()} />
			<meta name="author" content={name} />
		)}

		{article && article.updatedAt && (
			<meta property="article:modified_time" content={article.updatedAt.toISOString()} />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		{twitterHandle && (
			<meta name="twitter:site" content={twitterHandle} />
			<meta name="twitter:creator" content={twitterHandle} />
		)}
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
	</head>
	<body>
		<!-- <Announcement /> -->
		<Navbar />
		<main data-pagefind-ignore={pagefindIgnore}>
			<LayoutGrid>
				<slot name="left" slot="left" />
				<slot name="right" slot="right" />
			</LayoutGrid>
			<slot name="404" />
		</main>
		<Background />
		<footer class="site-footer">
			<div class="footer-container">
			  <p>
				Projet réalisé dans le cadre du Laboratoire HackLab de l’<a href="https://www.esgi.fr/" target="_blank" rel="noopener noreferrer">ESGI</a>.<br/>
				Ce site est non commercial et n’a pas de vocation lucrative.
			  </p>
			  <p>
				Le <a href="https://github.com/louisescher/spectre" target="_blank" rel="noopener noreferrer">template</a> utilisé est open source et disponible sous <a href="https://mit-license.org/" target="_blank" rel="noopener noreferrer">License MIT</a>.
			  </p>
			</div>
		  </footer>
	</body>
</html>
